generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// No User model: this is a shared public vault, not per-account storage.
// Viewing/uploading/editing needs no login; only deletion is admin-gated
// (see be/src/middleware/requireAdmin.ts).
model Media {
  id             String    @id @default(cuid())
  type           MediaType
  storageKey     String    @unique // object key in bucket (original)
  thumbnailKey   String? // object key for generated thumbnail
  width          Int?
  height         Int?
  durationSec    Int? // for video
  takenAt        DateTime? // from EXIF, falls back to uploadedAt
  latitude       Float?
  longitude      Float?
  sizeBytes      Int? // original + thumbnail bytes combined, as actually written to storage; null for rows uploaded before this field existed (not backfilled)
  contentHash    String? // SHA-256 of the original file bytes — exact-duplicate detection (be/src/lib/contentHash.ts)
  perceptualHash String? // dHash, images only — near-duplicate detection (ai/src/perceptualHash.ts). Null for videos and for rows uploaded before this feature existed (not backfilled, same as sizeBytes above).
  uploadedAt     DateTime  @default(now())
  deletedAt      DateTime? // soft delete: non-null = sitting in the trash, not purged yet

  albums AlbumMedia[]

  @@index([takenAt])
  @@index([uploadedAt]) // GET /api/media orders by this
  @@index([deletedAt]) // trash listing / excluding trashed rows from every other query
  @@index([contentHash]) // GET /api/duplicates' exact-match grouping
}

enum MediaType {
  IMAGE
  VIDEO
}

model Album {
  id          String      @id @default(cuid())
  title       String
  description String?
  coverKey    String?
  source      AlbumSource @default(MANUAL)
  createdAt   DateTime    @default(now())
  deletedAt   DateTime? // soft delete: non-null = sitting in the trash, not purged yet

  media AlbumMedia[]

  @@index([createdAt]) // GET /api/albums orders by this
  @@index([deletedAt])
}

enum AlbumSource {
  MANUAL // created by hand
  AUTO_DATE // auto-grouped by capture date range
  AUTO_LOCATION // auto-grouped by GPS proximity
}

model AlbumMedia {
  albumId String
  mediaId String
  addedAt DateTime @default(now())

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([albumId, mediaId])
  @@index([mediaId]) // "is this media in any album" lookups (auto-generate's ungrouped filter)
}

// Singleton row (fixed id "singleton", always upserted by that id — see
// be/src/lib/systemSettings.ts) gating the whole app behind an access code
// when isPublic is off. accessCode is stored in plain text, matching the
// existing ADMIN_PASSWORD comparison in be/src/lib/auth.ts — this system's
// threat model has never used hashing for its one shared secret, so this
// stays consistent rather than introducing bcrypt for a single field.
model SystemSettings {
  id                String   @id @default("singleton")
  isPublic          Boolean  @default(false)
  accessCode        String?
  // Admin-editable estimate, in bytes — there is no API to read the real
  // limit off the actual storage provider (checked Supabase Storage and
  // Render both directly; neither exposes account-level quota/usage via a
  // public API), so this is a manually-set threshold the admin compares
  // real usage against on the system-management page, not an authoritative
  // number pulled from the provider. Default 1 GiB.
  storageQuotaBytes Float    @default(1073741824)
  updatedAt         DateTime @updatedAt
}

// Records a duplicate cluster the admin/viewer explicitly dismissed
// ("Giữ nguyên" on /duplicates) so it stops reappearing. groupKey is the
// cluster's member Media ids, sorted and joined by "," — computed fresh
// each time be/src/routes/duplicates.ts runs detection, since groups
// aren't otherwise persisted anywhere (see that route for why).
model IgnoredDuplicateGroup {
  id        String   @id @default(cuid())
  groupKey  String   @unique
  createdAt DateTime @default(now())
}
