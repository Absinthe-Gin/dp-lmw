# Database — Supabase Postgres (Project Settings -> Database -> Connection string,
# "URI" tab, Session mode — not Transaction pooler, be/ is a persistent Node server).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Object storage: "local" (disk, no creds needed — offline/no-cloud dev only) or "s3".
STORAGE_DRIVER="s3"
PUBLIC_BASE_URL="http://localhost:4000"

# S3-compatible storage. Supabase Storage (same project as DATABASE_URL) works out of
# the box: Storage -> New bucket, then Storage -> S3 Connection -> New access key.
#   STORAGE_ENDPOINT = https://<project-ref>.supabase.co/storage/v1/s3
#   STORAGE_REGION   = same region as the project (e.g. ap-southeast-1)
# Cloudflare R2 is a drop-in alternative (same STORAGE_* shape, different values)
# if Supabase Storage's free-tier limits are outgrown.
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Admin login (the only login in this system — gates delete only)
ADMIN_PASSWORD=""
JWT_SECRET=""

# CORS
FRONTEND_ORIGIN="http://localhost:3000"

PORT=4000
